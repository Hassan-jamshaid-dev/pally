# Copy to .env (git-ignored). The key is read ONLY by the server in /server. Never put it in the Expo app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787
RATE_LIMIT_PER_MIN=20

# Optional, for the Expo app (public, not secret). Needed if auto-detection of your PC fails,
# or when the server is deployed:
# EXPO_PUBLIC_PALLY_API_URL=http://192.168.1.50:8787
